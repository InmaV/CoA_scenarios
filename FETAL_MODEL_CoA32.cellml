        <variable name="Qi1" public_interface="in" units="UnitQ"/>
        <variable name="Qi2" public_interface="in" units="UnitQ"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Pi1</ci>
                <ci>Po</ci>
            </apply>
            <apply>
                <eq/>
                <ci>Pi2</ci>
                <ci>Po</ci>
            </apply>
            <apply>
                <eq/>
                <ci>Qo</ci>
                <apply>
                    <plus/>
                    <ci>Qi1</ci>
                    <ci>Qi2</ci>
                </apply>
            </apply>
        </math>
    </component>
